{
  "engine": "service-suite",
  "id": "security",
  "domain": "security.hngroup.org.uk",
  "aliases": [],
  "port": 5060,
  "company": "group",
  "name": "HN Group Security",
  "brand": "HN Group",
  "logo": "hn-group-wordmark",
  "staffOnly": false,
  "staffSignIn": "admin",
  "staffLabel": "HN Group",
  "hero": {
    "eyebrow": "HN GROUP SECURITY",
    "title": "Report a security issue.",
    "lead": "If you believe you have found a security vulnerability in an HN Group website or service, please tell us privately here.",
    "actions": [
      {
        "label": "Report a vulnerability",
        "href": "#/m/reports/new"
      },
      {
        "label": "Check a report",
        "href": "#/ref"
      }
    ]
  },
  "sections": [
    {
      "eyebrow": "HOW TO HELP",
      "title": "When you report",
      "text": "Please give enough detail for us to reproduce the issue, and avoid accessing, changing or keeping other people’s data. Do not run tests that could disrupt services, and give us time to investigate before sharing details publicly. You will receive a private reference to follow progress and talk with us."
    },
    {
      "eyebrow": "NOT SECURITY?",
      "title": "Other problems",
      "text": "For account help or general bugs, use HN Group Support or Feedback instead.",
      "link": {
        "url": "https://support.hngroup.org.uk",
        "label": "HN Group Support"
      }
    }
  ],
  "notices": [
    {
      "title": "No automatic emails.",
      "text": "This website does not send email notifications. Keep your private reference to check progress and read replies here.",
      "email": false
    }
  ],
  "related": [],
  "providers": {},
  "accounts": null,
  "securityTxt": {
    "module": "reports"
  },
  "brandkit": null,
  "tools": null,
  "privacy": "https://hngroup.org.uk/privacy",
  "footer": {
    "text": "HN Group brings together Horizon Network, Horizon Media Group and Horizon Holding Co.",
    "copyright": "HN Group Limited",
    "links": [
      {
        "label": "hngroup.org.uk",
        "url": "https://hngroup.org.uk"
      },
      {
        "label": "Support",
        "url": "https://support.hngroup.org.uk"
      },
      {
        "label": "Service status",
        "url": "https://status.hngroup.org.uk"
      },
      {
        "label": "All HN Group links",
        "url": "https://links.hngroup.org.uk"
      }
    ]
  },
  "storageLimitMb": 2048,
  "modules": [
    {
      "key": "reports",
      "type": "items",
      "title": "Vulnerability reports",
      "view": "manager",
      "create": "public",
      "manage": "admin",
      "reference": true,
      "comments": true,
      "consent": "I understand HN Group will use these details to respond, as described in the HN Group privacy notice.",
      "scope": "own",
      "singular": "report",
      "cta": "Report a vulnerability",
      "successTitle": "Report received",
      "successText": "Thank you for reporting this privately.",
      "internalNotes": true,
      "fields": [
        {
          "name": "title",
          "label": "Summary",
          "type": "text",
          "required": true,
          "max": 160
        },
        {
          "name": "target",
          "label": "Affected website, service or address",
          "type": "text",
          "required": true,
          "max": 300
        },
        {
          "name": "severity",
          "label": "Your severity assessment",
          "type": "select",
          "options": [
            {
              "value": "low",
              "label": "Low"
            },
            {
              "value": "medium",
              "label": "Medium"
            },
            {
              "value": "high",
              "label": "High"
            },
            {
              "value": "critical",
              "label": "Critical"
            },
            {
              "value": "not-sure",
              "label": "Not sure"
            }
          ],
          "filter": true
        },
        {
          "name": "body",
          "label": "Description",
          "type": "textarea",
          "max": 20000
        },
        {
          "name": "steps",
          "label": "Steps to reproduce",
          "type": "textarea",
          "max": 10000
        },
        {
          "name": "impact",
          "label": "Potential impact",
          "type": "textarea",
          "max": 5000
        },
        {
          "name": "name",
          "label": "Name or handle (optional)",
          "type": "text",
          "max": 120
        },
        {
          "name": "email",
          "label": "Email",
          "type": "email",
          "required": false,
          "contact": true,
          "autocomplete": "email"
        }
      ],
      "listFields": [
        "target",
        "severity"
      ],
      "statuses": [
        {
          "id": "new",
          "label": "New"
        },
        {
          "id": "triaging",
          "label": "Triaging"
        },
        {
          "id": "confirmed",
          "label": "Confirmed"
        },
        {
          "id": "fixed",
          "label": "Fixed"
        },
        {
          "id": "not-applicable",
          "label": "Not applicable"
        },
        {
          "id": "closed",
          "label": "Closed"
        }
      ],
      "empty": "Submissions are private to the person who sent them and our team. Use the button above to send one, or check an existing one with your private reference."
    },
    {
      "key": "advisories",
      "type": "items",
      "title": "Security advisories",
      "view": "public",
      "create": "manager",
      "manage": "admin",
      "publish": true,
      "comments": false,
      "singular": "advisory",
      "fields": [
        {
          "name": "title",
          "label": "Advisory",
          "type": "text",
          "required": true,
          "max": 160
        },
        {
          "name": "published",
          "label": "Published",
          "type": "date"
        },
        {
          "name": "severity",
          "label": "Severity",
          "type": "select",
          "options": [
            {
              "value": "low",
              "label": "Low"
            },
            {
              "value": "medium",
              "label": "Medium"
            },
            {
              "value": "high",
              "label": "High"
            },
            {
              "value": "critical",
              "label": "Critical"
            }
          ]
        },
        {
          "name": "affected",
          "label": "Affected",
          "type": "text",
          "max": 300
        },
        {
          "name": "summary",
          "label": "Summary",
          "type": "text",
          "max": 300
        },
        {
          "name": "body",
          "label": "Details",
          "type": "textarea",
          "max": 20000
        }
      ],
      "listFields": [
        "published",
        "severity"
      ],
      "empty": "No security advisories have been published."
    }
  ],
  "seedAuthor": "HN Group"
}
