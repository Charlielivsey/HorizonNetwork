    {
      "key": "library",
      "type": "items",
      "title": "Report library",
      "view": "staff",
      "create": "manager",
      "manage": "admin",
      "comments": true,
      "display": "cards",
      "singular": "report",
      "files": "manager",
      "fields": [
        {
          "name": "title",
          "label": "Report",
          "type": "text",
          "required": true,
          "max": 160
        },
        {
          "name": "period",
          "label": "Period",
          "type": "text",
          "max": 60
        },
        {
          "name": "company",
          "label": "Company",
          "type": "select",
          "options": [
            "HN Group",
            "Horizon Network",
            "Horizon Media Group",
            "Horizon Holding Co",
            "Horizon Advertising",
            "Horizon Development"
          ],
          "filter": true
        },
