  "aliases": [],
  "port": 4900,
  "company": "group",
  "name": "HN Group Assets",
  "brand": "Horizon Holding Co",
  "logo": "horizon-holding-co-logo",
  "staffOnly": true,
  "staffSignIn": "any",
  "staffLabel": "Horizon Holding Co",
  "hero": {
    "eyebrow": "HORIZON HOLDING CO",
    "title": "Group asset inventory.",
    "lead": "Horizon Holding Co owns the group’s assets, domains, Discord servers and technical assets. This private inventory records them and who looks after each one.",
    "actions": [
      {
        "label": "View inventory",
        "href": "#/m/inventory"
      }
    ]
  },
  "sections": [],
  "notices": [],
  "related": [],
  "providers": {},
  "accounts": null,
  "securityTxt": null,
  "brandkit": null,
  "tools": null,
  "privacy": "https://hngroup.org.uk/privacy",
  "footer": {
    "text": "HN Group brings together Horizon Network, Horizon Media Group and Horizon Holding Co.",
    "copyright": "HN Group Limited",
    "links": [
      {
        "label": "hngroup.org.uk",
        "url": "https://hngroup.org.uk"
      },
      {
        "label": "Support",
        "url": "https://support.hngroup.org.uk"
      },
      {
        "label": "Service status",
        "url": "https://status.hngroup.org.uk"
      },
      {
        "label": "All HN Group links",
        "url": "https://links.hngroup.org.uk"
      }
    ]
  },
  "storageLimitMb": 2048,
  "modules": [
    {
      "key": "inventory",
      "type": "items",
      "title": "Inventory",
      "view": "staff",
      "create": "manager",
      "manage": "admin",
      "comments": true,
      "display": "table",
      "singular": "asset",
      "files": "manager",
      "intro": "Staff can view the inventory; administrators can add and change assets.",
      "fields": [
        {
          "name": "title",
          "label": "Asset",
          "type": "text",
          "required": true,
          "max": 160
        },
        {
          "name": "category",
          "label": "Category",
          "type": "select",
          "required": true,
          "filter": true,
          "options": [
            {
              "value": "laptop",
              "label": "Laptop"
            },
            {
              "value": "desktop",
              "label": "Desktop"
            },
            {
              "value": "phone",
              "label": "Phone"
            },
            {
              "value": "tablet",
              "label": "Tablet"
            },
            {
              "value": "server",
              "label": "Server"
            },
            {
              "value": "network-equipment",
              "label": "Network equipment"
            },
            {
              "value": "peripheral",
              "label": "Peripheral"
            },
            {
              "value": "domain",
              "label": "Domain"
            },
            {
              "value": "discord-server",
              "label": "Discord server"
            },
            {
              "value": "hosting-vps",
              "label": "Hosting / VPS"
            },
            {
              "value": "software-account",
              "label": "Software account"
            },
            {
              "value": "other",
              "label": "Other"
            }
          ]
        },
        {
          "name": "tag",
          "label": "Asset tag",
          "type": "text",
          "max": 60
        },
        {
          "name": "serial",
          "label": "Serial number",
          "type": "text",
          "max": 120,
          "internal": true
        },
        {
          "name": "owner",
          "label": "Owned by",
          "type": "select",
          "options": [
            "HN Group",
            "Horizon Network",
            "Horizon Media Group",
            "Horizon Holding Co",
            "Horizon Advertising",
            "Horizon Development"
          ],
          "filter": true
        },
        {
          "name": "assignee",
          "label": "Looked after by",
          "type": "user"
        },
        {
          "name": "location",
          "label": "Location",
          "type": "text",
          "max": 120
        },
        {
          "name": "purchased",
          "label": "Acquired",
          "type": "date"
        },
        {
          "name": "cost",
          "label": "Cost (£)",
          "type": "money",
          "internal": true
        },
        {
          "name": "renewal",
          "label": "Warranty or renewal date",
          "type": "date"
        },
        {
          "name": "notes",
          "label": "Notes",
          "type": "textarea",
          "max": 5000,
          "internal": true
        }
      ],
      "listFields": [
        "category",
        "tag",
        "owner",
        "assignee",
        "renewal"
      ],
      "statuses": [
        {
          "id": "in-use",
          "label": "In use"
        },
        {
          "id": "available",
          "label": "Available"
        },
        {
          "id": "repair",
          "label": "In repair"
        },
        {
          "id": "retired",
          "label": "Retired"
        },
        {
          "id": "lost",
          "label": "Lost"
        }
      ],
      "empty": "No assets recorded yet."
    }
  ],
  "seedAuthor": "Horizon Holding Co"
}
