#!/usr/bin/env python3
"""HN Group mail: Dovecot checkpassword for mail app passwords (Outlook, Apple Mail, phones …).

Each mailbox owner creates app passwords in HN Mail (Settings → Mail apps). Only scrypt hashes are kept, in
/etc/hn-mail/dovecot/app-passwords.json (written by the mail directory on admin.mail.hngroup.org.uk):
  {"version": 1, "mailboxes": {"ada@hngroup.org.uk": [{"id": "…", "salt": "<hex>", "hash": "<hex>"}]}}
An app password belongs to one mailbox and is revoked by deleting it. HN Group Auth passwords are never used or
stored here. Protocol: https://doc.dovecot.org/configuration_manual/authentication/checkpassword/
Exit 1 = wrong user/password, 111 = temporary failure. Nothing secret is ever written to the log.
"""
import hashlib, hmac, json, os, sys

STORE = os.environ.get('HN_MAIL_APP_PASSWORDS', '/etc/hn-mail/dovecot/app-passwords.json')
N, R, P = 2 ** 14, 8, 1


def read_input():
    data = b''
    with os.fdopen(3, 'rb') as f:
        while len(data) < 2048:
            chunk = f.read(2048 - len(data))
            if not chunk:
                break
            data += chunk
    parts = data.split(b'\0')
    if len(parts) < 2:
        sys.exit(1)
    return parts[0].decode('utf-8', 'replace').strip().lower(), parts[1]


def main():
    user, password = read_input()
    if not user or '*' in user or len(password) < 16 or len(password) > 200:
        sys.exit(1)
    try:
        with open(STORE, 'r', encoding='utf-8') as f:
            store = json.load(f)
    except FileNotFoundError:
        sys.exit(1)
    except Exception:
        sys.exit(111)
    entries = (store.get('mailboxes') or {}).get(user) or []
    ok = False
    for e in entries[:50]:
        try:
            digest = hashlib.scrypt(password, salt=bytes.fromhex(e['salt']), n=N, r=R, p=P, dklen=32)
            if hmac.compare_digest(digest.hex(), e['hash']):
                ok = True
        except Exception:
            continue
    if not ok:
        sys.exit(1)
    os.environ['USER'] = user
    reply = sys.argv[1:] or []
    if not reply:
        sys.exit(0)
    os.execv(reply[0], reply)


if __name__ == '__main__':
    main()
