#!/bin/sh
# HN Group mail: private nightly backup (cron at 03:17, /etc/cron.d/hn-mail-backup). Keeps 7 days in
# /var/backups/hn-mail (root only). Contains every mailbox (/var/vmail), the mail settings (/etc/hn-mail, including
# HN Mail's master secret), the DKIM private keys and the mail directory (/var/lib/hn-mail-admin).
# Restore: see mail-server/README.md ("Restoring from a backup").
set -eu
DEST=/var/backups/hn-mail
STAMP="$(date +%Y%m%d-%H%M%S)"
mkdir -p "$DEST"; chmod 700 "$DEST"
umask 077
FILE="$DEST/mail-$STAMP.tar.gz"
tar -czf "$FILE.partial" --ignore-failed-read -C / var/vmail etc/hn-mail var/lib/rspamd/dkim var/lib/hn-mail-admin 2>/dev/null || [ $? -eq 1 ]
mv "$FILE.partial" "$FILE"
find "$DEST" -maxdepth 1 -name 'mail-*.tar.gz' -mtime +7 -delete
echo "$(date -Is) backup $FILE $(du -h "$FILE" | cut -f1)"
