#!/bin/sh
# HN Group mail: tells a mailbox when it reaches 90% and 100% of its storage limit (Dovecot quota_warning).
# Usage (from Dovecot): quota-warning <percent> <mailbox address>. Runs as vmail and delivers straight into the
# mailbox's inbox with dovecot-lda, so the warning arrives even when the mailbox is full (quota is not checked).
PERCENT="$1"
USER="$2"
case "$USER" in *[!A-Za-z0-9@._+-]*|'') exit 0 ;; esac
case "$PERCENT" in 90|100) ;; *) exit 0 ;; esac
if [ "$PERCENT" = 100 ]; then
  TEXT="Your mailbox $USER is full. New messages can't be delivered until you delete some mail (empty the Bin and Junk folders) or ask an HN Group mail administrator for more space. Mail sent to you in the meantime is not lost: senders' mail servers keep trying for several days."
else
  TEXT="Your mailbox $USER is $PERCENT% full. Delete messages you no longer need (and empty the Bin) or ask an HN Group mail administrator for more space before it fills up."
fi
cat << EOF | /usr/lib/dovecot/dovecot-lda -d "$USER" -o "plugin/quota=count:Mailbox storage:noenforcing"
From: HN Group Mail <postmaster@hngroup.org.uk>
To: $USER
Subject: Your mailbox is $PERCENT% full
Auto-Submitted: auto-generated
Content-Type: text/plain; charset=UTF-8

$TEXT

HN Group Mail
EOF
