#!/usr/bin/env bash
# hn-mail-relay: send outgoing mail through a relay (e.g. Brevo) instead of straight to other providers on port 25.
#   sudo hn-mail-relay set      ask for the relay's SMTP login and key (typed hidden, never shown or logged) and turn it on
#   sudo hn-mail-relay status   show whether a relay is on (never shows the key)
#   sudo hn-mail-relay off      deliver straight to other providers again (when the host has unblocked port 25)
# Only mail leaving HN Group goes through the relay; mail between HN Group mailboxes stays on this server. Our own DKIM
# signature (added by Rspamd before the mail leaves) is kept. The key is stored only in /etc/postfix/hn-relay-sasl
# (root only, 600).
set -euo pipefail
CONF=/etc/hn-mail/relay.conf
SASL=/etc/postfix/hn-relay-sasl
TLS=/etc/postfix/hn-relay-tls
[ "$(id -u)" = 0 ] || { echo 'Run with sudo.' >&2; exit 1; }

off() {
    postconf -e 'relayhost =' 'smtp_sasl_auth_enable = no'
    postconf -X smtp_sasl_password_maps smtp_sasl_security_options smtp_sasl_tls_security_options smtp_tls_policy_maps 2>/dev/null || true
    rm -f "$SASL" "$TLS" "$CONF"
    systemctl reload postfix
    echo 'Relay off: outgoing mail goes straight to other providers on port 25.'
}

apply() { # host port login key
    local relay="[$1]:$2"
    umask 077
    printf '%s %s:%s\n' "$relay" "$3" "$4" > "$SASL"
    printf '%s encrypt\n' "$relay" > "$TLS"
    printf 'host=%s\nport=%s\nlogin=%s\n' "$1" "$2" "$3" > "$CONF"
    chmod 600 "$SASL" "$TLS" "$CONF"
    postconf -e "relayhost = $relay" \
        'smtp_sasl_auth_enable = yes' \
        "smtp_sasl_password_maps = texthash:$SASL" \
        'smtp_sasl_security_options = noanonymous' \
        'smtp_sasl_tls_security_options = noanonymous' \
        "smtp_tls_policy_maps = texthash:$TLS"
    systemctl reload postfix
}

case "${1:-status}" in
    set)
        read -r -p 'Relay server [smtp-relay.brevo.com]: ' host; host="${host:-smtp-relay.brevo.com}"
        read -r -p 'Port [587]: ' port; port="${port:-587}"
        read -r -p 'SMTP login (Brevo: the "Login" shown under SMTP & API → SMTP, e.g. 1a2b3c@smtp-brevo.com): ' login
        read -r -s -p 'SMTP key (Brevo: SMTP & API → SMTP → Generate a new SMTP key; typing is hidden): ' key; echo
        [[ "$host" =~ ^[A-Za-z0-9.-]+$ && "$port" =~ ^[0-9]+$ && -n "$login" && -n "$key" && "$login$key" != *[[:space:]]* ]] \
            || { echo 'Missing or invalid details; nothing changed.' >&2; exit 1; }
        # Check the login works before switching mail over to it.
        if ! python3 - "$host" "$port" "$login" "$key" <<'PY'
import smtplib, ssl, sys
h, p, u, k = sys.argv[1], int(sys.argv[2]), sys.argv[3], sys.argv[4]
try:
    s = smtplib.SMTP(h, p, timeout=20); s.starttls(context=ssl.create_default_context()); s.login(u, k); s.quit()
except Exception as e:
    print('The relay refused the sign-in: ' + str(e)[:200], file=sys.stderr); sys.exit(1)
PY
        then echo 'Nothing changed.' >&2; exit 1; fi
        apply "$host" "$port" "$login" "$key"
        echo "Relay on: outgoing mail now goes through $host:$port (signed in as $login)."
        ;;
    reapply) # used by install.sh: keeps an existing relay after a reinstall
        [ -f "$CONF" ] && [ -f "$SASL" ] || exit 0
        . "$CONF"
        key="$(awk '{print $2}' "$SASL" | head -1)"; key="${key#*:}"
        apply "$host" "$port" "$login" "$key"
        ;;
    status)
        if [ -f "$CONF" ]; then . "$CONF"; echo "Relay on: $host:$port, login $login."; else echo 'Relay off: mail goes straight to other providers on port 25.'; fi
        ;;
    off) off ;;
    *) echo 'Usage: hn-mail-relay set|status|off' >&2; exit 2 ;;
esac
