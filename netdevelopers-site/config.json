{
  "engine": "service-suite",
  "id": "netdevelopers",
  "domain": "developers.horizonetwork.com",
  "aliases": [
    "developers.horizon-network.co.uk"
  ],
  "port": 5130,
  "company": "network",
  "name": "Horizon Network Developers",
  "brand": "Horizon Network",
  "logo": "horizon-network-wordmark",
  "staffOnly": false,
  "staffSignIn": "admin",
  "staffLabel": "Horizon Network",
  "hero": {
    "eyebrow": "HORIZON NETWORK DEVELOPERS",
    "title": "Developer resources.",
    "lead": "Documentation and resources for building on Horizon Network services, published here as they become available.",
    "actions": [
      {
        "label": "Documentation",
        "href": "#/m/docs"
      },
      {
        "label": "Ask a question",
        "href": "#/m/questions/new"
      }
    ]
  },
  "sections": [],
  "notices": [
    {
      "title": "No automatic emails.",
      "text": "This website does not send email notifications. Keep your private reference to check progress and read replies here.",
      "email": false
    }
  ],
  "related": [],
  "providers": {},
  "accounts": null,
  "securityTxt": null,
  "brandkit": null,
  "tools": null,
  "privacy": "https://horizon-network.co.uk/privacy",
  "footer": {
    "text": "Horizon Network brings together digital infrastructure, advertising and software. A subsidiary of HN Group Limited.",
    "copyright": "Horizon Network · A subsidiary of HN Group Limited",
    "links": [
      {
        "label": "horizon-network.co.uk",
        "url": "https://horizon-network.co.uk"
      },
      {
        "label": "Network status",
        "url": "https://status.horizon-network.co.uk"
      },
      {
        "label": "All HN Group links",
        "url": "https://links.hngroup.org.uk"
      }
    ]
  },
  "storageLimitMb": 2048,
  "modules": [
    {
      "key": "docs",
      "type": "items",
      "title": "Documentation",
      "view": "public",
      "create": "manager",
      "manage": "admin",
      "publish": true,
      "comments": false,
      "singular": "document",
      "files": "manager",
      "fields": [
        {
          "name": "title",
          "label": "Title",
          "type": "text",
          "required": true,
          "max": 160
        },
        {
          "name": "category",
          "label": "Section",
          "type": "select",
          "filter": true,
          "options": [
            {
              "value": "getting-started",
              "label": "Getting started"
            },
            {
              "value": "guides",
              "label": "Guides"
            },
            {
              "value": "api-reference",
              "label": "API reference"
            },
            {
              "value": "changelog",
              "label": "Changelog"
            }
          ]
        },
        {
          "name": "version",
          "label": "Version",
          "type": "text",
          "max": 40
        },
        {
          "name": "summary",
          "label": "Summary",
          "type": "text",
          "max": 300
        },
        {
          "name": "body",
          "label": "Content",
          "type": "textarea",
          "max": 20000
        }
      ],
      "listFields": [
        "category",
        "version"
      ],
      "empty": "No Horizon Network developer documentation has been published yet."
    },
    {
      "key": "questions",
      "type": "items",
      "title": "Developer questions",
      "view": "manager",
      "create": "public",
      "manage": "admin",
      "reference": true,
      "comments": true,
      "consent": "I understand Horizon Network will use these details to respond, as described in the Horizon Network privacy notice.",
      "scope": "own",
      "singular": "question",
      "cta": "Ask a question",
      "fields": [
        {
          "name": "name",
          "label": "Your name",
          "type": "text",
          "required": true,
          "max": 120,
          "autocomplete": "name"
        },
        {
          "name": "email",
          "label": "Email",
          "type": "email",
          "required": true,
          "contact": true,
          "autocomplete": "email"
        },
        {
          "name": "title",
          "label": "Subject",
          "type": "text",
          "required": true,
          "max": 160
        },
        {
          "name": "body",
          "label": "Your question",
          "type": "textarea",
          "max": 20000
        }
      ],
      "statuses": [
        {
          "id": "new",
          "label": "New"
        },
        {
          "id": "in-progress",
          "label": "In progress"
        },
        {
          "id": "resolved",
          "label": "Resolved"
        },
        {
          "id": "closed",
          "label": "Closed"
        }
      ],
      "empty": "Submissions are private to the person who sent them and our team. Use the button above to send one, or check an existing one with your private reference."
    }
  ],
  "seedAuthor": "Horizon Network"
}
