{
  "engine": "service-suite",
  "id": "events",
  "domain": "events.hngroup.org.uk",
  "aliases": [],
  "port": 4850,
  "company": "group",
  "name": "HN Group Events",
  "brand": "HN Group",
  "logo": "hn-group-wordmark",
  "staffOnly": false,
  "staffSignIn": "any",
  "staffLabel": "HN Group",
  "hero": {
    "eyebrow": "HN GROUP EVENTS",
    "title": "Events and registration.",
    "lead": "Upcoming HN Group events, with online registration. Staff can also see the internal staff calendar.",
    "actions": [
      {
        "label": "Upcoming events",
        "href": "#/m/events"
      }
    ]
  },
  "sections": [],
  "notices": [],
  "related": [],
  "providers": {},
  "accounts": null,
  "securityTxt": null,
  "brandkit": null,
  "tools": null,
  "privacy": "https://hngroup.org.uk/privacy",
  "footer": {
    "text": "HN Group brings together Horizon Network, Horizon Media Group and Horizon Holding Co.",
    "copyright": "HN Group Limited",
    "links": [
      {
        "label": "hngroup.org.uk",
        "url": "https://hngroup.org.uk"
      },
      {
        "label": "Support",
        "url": "https://support.hngroup.org.uk"
      },
      {
        "label": "Service status",
        "url": "https://status.hngroup.org.uk"
      },
      {
        "label": "All HN Group links",
        "url": "https://links.hngroup.org.uk"
      }
    ]
  },
  "storageLimitMb": 2048,
  "modules": [
    {
      "key": "events",
      "type": "items",
      "title": "Events",
      "view": "public",
      "create": "manager",
      "manage": "admin",
      "publish": true,
      "comments": false,
      "singular": "event",
      "capacity": {
        "module": "registrations"
      },
      "intro": "Register for upcoming events. Places are limited where shown.",
      "fields": [
        {
          "name": "title",
          "label": "Event",
          "type": "text",
          "required": true,
          "max": 160
        },
        {
          "name": "summary",
          "label": "Summary",
          "type": "text",
          "max": 300
        },
        {
          "name": "starts",
          "label": "Starts",
          "type": "datetime",
          "required": true
        },
        {
          "name": "ends",
          "label": "Ends",
          "type": "datetime"
        },
        {
          "name": "location",
          "label": "Location",
          "type": "text",
          "max": 160
        },
        {
          "name": "online",
          "label": "Online link",
          "type": "url",
          "internal": true,
          "help": "Only shown to staff; share joining details with registrants directly."
        },
        {
          "name": "capacity",
          "label": "Places (0 = unlimited)",
          "type": "number",
          "min": 0,
          "max": 100000
        },
        {
          "name": "closes",
          "label": "Registration closes",
          "type": "datetime"
        },
        {
          "name": "body",
          "label": "About this event",
          "type": "textarea",
          "max": 20000
        }
      ],
      "listFields": [
        "starts",
        "location"
      ],
      "empty": "There are no upcoming events at the moment."
    },
    {
      "key": "registrations",
      "type": "items",
      "title": "Registrations",
      "view": "manager",
      "create": "public",
      "manage": "admin",
      "reference": true,
      "comments": true,
      "consent": "I understand HN Group will use these details to respond, as described in the HN Group privacy notice.",
      "scope": "own",
      "singular": "registration",
      "parent": {
        "module": "events",
        "label": "Event",
        "cta": "Register",
        "capacity": "capacity",
        "closes": "closes",
        "unique": "email"
      },
      "fields": [
        {
          "name": "name",
          "label": "Your name",
          "type": "text",
          "required": true,
          "max": 120,
          "autocomplete": "name"
        },
        {
          "name": "email",
          "label": "Email",
          "type": "email",
          "required": true,
          "contact": true,
          "autocomplete": "email"
        },
        {
          "name": "organisation",
          "label": "Organisation",
          "type": "text",
          "max": 120
        },
        {
          "name": "requirements",
          "label": "Accessibility or dietary requirements",
          "type": "textarea",
          "max": 2000
        }
      ],
      "statuses": [
        {
          "id": "registered",
          "label": "Registered"
        },
        {
          "id": "attended",
          "label": "Attended"
        },
        {
          "id": "cancelled",
          "label": "Cancelled"
        }
      ],
      "cancellable": [
        "registered"
      ],
      "successTitle": "You are registered",
      "successText": "Your place has been recorded. Keep your private reference to check or cancel your registration.",
      "empty": "Submissions are private to the person who sent them and our team. Use the button above to send one, or check an existing one with your private reference."
    },
    {
      "key": "calendar",
      "type": "bridge",
      "title": "Staff calendar",
      "nav": "Staff calendar",
      "intro": "Company events from the staff portal calendar, with bank holidays and leave. Editing needs the events permission in the staff portal.",
      "render": "calendar",
      "portalUrl": "https://staff.hngroup.org.uk/calendar",
      "load": {
        "path": "/api/calendar",
        "query": [
          {
            "name": "from",
            "label": "From",
            "type": "date"
          },
          {
            "name": "to",
            "label": "To",
            "type": "date"
          }
        ]
      },
      "views": [
        {
          "id": "calendar",
          "label": "Calendar",
          "items": "items",
          "columns": [],
          "actions": [
            {
              "id": "delete",
              "label": "Delete",
              "path": "/api/events/{id}/delete"
            }
          ]
        }
      ],
      "forms": [
        {
          "id": "event",
          "label": "Add a staff event",
          "path": "/api/events",
          "when": "canManage",
          "fields": [
            {
              "name": "title",
              "label": "Title",
              "type": "text",
              "required": true,
              "max": 150
            },
            {
              "name": "type",
              "label": "Type",
              "type": "select",
              "options": [
                {
                  "value": "event",
                  "label": "Event"
                },
                {
                  "value": "meeting",
                  "label": "Meeting"
                },
                {
                  "value": "social",
                  "label": "Social"
                },
                {
                  "value": "training",
                  "label": "Training"
                },
                {
                  "value": "holiday",
                  "label": "Holiday"
                }
              ]
            },
            {
              "name": "startDate",
              "label": "Start date",
              "type": "date",
              "required": true
            },
            {
              "name": "endDate",
              "label": "End date",
              "type": "date"
            },
            {
              "name": "allDay",
              "label": "All day",
              "type": "checkbox"
            },
            {
              "name": "startTime",
              "label": "Start time",
              "type": "time"
            },
            {
              "name": "endTime",
              "label": "End time",
              "type": "time"
            },
            {
              "name": "location",
              "label": "Location",
              "type": "text",
              "max": 150
            },
            {
              "name": "description",
              "label": "Description",
              "type": "textarea",
              "max": 2000
            }
          ]
        }
      ]
    }
  ],
  "seedAuthor": "HN Group"
}
