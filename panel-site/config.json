{
  "engine": "service-suite",
  "id": "panel",
  "domain": "panel.horizon-network.co.uk",
  "aliases": [
    "panel.horizonetwork.com"
  ],
  "port": 5100,
  "company": "network",
  "name": "Horizon Network Panel",
  "brand": "Horizon Network",
  "logo": "horizon-network-wordmark",
  "staffOnly": true,
  "staffSignIn": "any",
  "staffLabel": "Horizon Network",
  "hero": {
    "eyebrow": "HORIZON NETWORK PANEL",
    "title": "Hosting control panel.",
    "lead": "For authorised Horizon Network staff: the register of hosting services and their status. Automatic provisioning is not connected yet.",
    "actions": [
      {
        "label": "Services",
        "href": "#/m/services"
      }
    ]
  },
  "sections": [],
  "notices": [],
  "related": [],
  "providers": {
    "provisioning": {
      "label": "Provisioning system",
      "status": "awaiting-configuration",
      "note": "Not connected. Status changes here are records kept by staff; they do not create, start or stop any server."
    }
  },
  "accounts": null,
  "securityTxt": null,
  "brandkit": null,
  "tools": null,
  "privacy": "https://horizon-network.co.uk/privacy",
  "footer": {
    "text": "Horizon Network brings together digital infrastructure, advertising and software. A subsidiary of HN Group Limited.",
    "copyright": "Horizon Network · A subsidiary of HN Group Limited",
    "links": [
      {
        "label": "horizon-network.co.uk",
        "url": "https://horizon-network.co.uk"
      },
      {
        "label": "Network status",
        "url": "https://status.horizon-network.co.uk"
      },
      {
        "label": "All HN Group links",
        "url": "https://links.hngroup.org.uk"
      }
    ]
  },
  "storageLimitMb": 2048,
  "modules": [
    {
      "key": "services",
      "type": "items",
      "title": "Hosting services",
      "view": "staff",
      "create": "manager",
      "manage": "admin",
      "comments": true,
      "display": "table",
      "singular": "service",
      "intro": "Staff can view; administrators maintain records. Changing a status here does not act on any server.",
      "fields": [
        {
          "name": "title",
          "label": "Service name",
          "type": "text",
          "required": true,
          "max": 160
        },
        {
          "name": "customer",
          "label": "Customer",
          "type": "text",
          "max": 160
        },
        {
          "name": "kind",
          "label": "Type",
          "type": "select",
          "filter": true,
          "options": [
            {
              "value": "vps",
              "label": "VPS"
            },
            {
              "value": "dedicated-server",
              "label": "Dedicated server"
            },
            {
              "value": "managed-cloud",
              "label": "Managed cloud"
            },
            {
              "value": "website-hosting",
              "label": "Website hosting"
            },
            {
              "value": "other",
              "label": "Other"
            }
          ]
        },
        {
          "name": "hostname",
          "label": "Hostname",
          "type": "text",
          "max": 200,
          "internal": true
        },
        {
          "name": "location",
          "label": "Location",
          "type": "text",
          "max": 120
        },
        {
          "name": "renewal",
          "label": "Renewal date",
          "type": "date"
        },
        {
          "name": "notes",
          "label": "Notes",
          "type": "textarea",
          "max": 5000,
          "internal": true
        }
      ],
      "listFields": [
        "customer",
        "kind",
        "renewal"
      ],
      "statuses": [
        {
          "id": "requested",
          "label": "Requested"
        },
        {
          "id": "awaiting-provider",
          "label": "Awaiting provider configuration"
        },
        {
          "id": "active",
          "label": "Active"
        },
        {
          "id": "suspended",
          "label": "Suspended"
        },
        {
          "id": "cancelled",
          "label": "Cancelled"
        }
      ],
      "empty": "No hosting services are recorded."
    }
  ],
  "seedAuthor": "Horizon Network"
}
