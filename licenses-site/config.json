{
  "engine": "service-suite",
  "id": "licenses",
  "domain": "licenses.hngroup.org.uk",
  "aliases": [],
  "port": 4990,
  "company": "group",
  "name": "HN Group Licences",
  "brand": "HN Group",
  "logo": "hn-group-wordmark",
  "staffOnly": true,
  "staffSignIn": "any",
  "staffLabel": "HN Group",
  "hero": {
    "eyebrow": "HN GROUP LICENCES",
    "title": "Software licences and renewals.",
    "lead": "Every software licence and subscription the group holds, with seats, costs and renewal dates.",
    "actions": [
      {
        "label": "Licences",
        "href": "#/m/licences"
      }
    ]
  },
  "sections": [],
  "notices": [],
  "related": [],
  "providers": {},
  "accounts": null,
  "securityTxt": null,
  "brandkit": null,
  "tools": null,
  "privacy": "https://hngroup.org.uk/privacy",
  "footer": {
    "text": "HN Group brings together Horizon Network, Horizon Media Group and Horizon Holding Co.",
    "copyright": "HN Group Limited",
    "links": [
      {
        "label": "hngroup.org.uk",
        "url": "https://hngroup.org.uk"
      },
      {
        "label": "Support",
        "url": "https://support.hngroup.org.uk"
      },
      {
        "label": "Service status",
        "url": "https://status.hngroup.org.uk"
      },
      {
        "label": "All HN Group links",
        "url": "https://links.hngroup.org.uk"
      }
    ]
  },
  "storageLimitMb": 2048,
  "modules": [
    {
      "key": "licences",
      "type": "items",
      "title": "Licences",
      "view": "staff",
      "create": "manager",
      "manage": "admin",
      "comments": true,
      "display": "table",
      "singular": "licence",
      "files": "manager",
      "intro": "Sorted with the next renewals first in each view. Staff can view; administrators maintain licences.",
      "fields": [
        {
          "name": "title",
          "label": "Software",
          "type": "text",
          "required": true,
          "max": 160
        },
        {
          "name": "vendor",
          "label": "Vendor",
          "type": "text",
          "max": 120
        },
        {
          "name": "kind",
          "label": "Licence type",
          "type": "select",
          "filter": true,
          "options": [
            {
              "value": "subscription",
              "label": "Subscription"
            },
            {
              "value": "perpetual",
              "label": "Perpetual"
            },
            {
              "value": "open-source",
              "label": "Open source"
            },
            {
              "value": "trial",
              "label": "Trial"
            },
            {
              "value": "free-plan",
              "label": "Free plan"
            }
          ]
        },
        {
          "name": "seats",
          "label": "Seats",
          "type": "number",
          "min": 0,
          "max": 100000
        },
        {
          "name": "cost",
          "label": "Cost (£)",
          "type": "money",
          "internal": true
        },
        {
          "name": "billing",
          "label": "Billing",
          "type": "select",
          "options": [
            {
              "value": "monthly",
              "label": "Monthly"
            },
            {
              "value": "annual",
              "label": "Annual"
            },
            {
              "value": "one-off",
              "label": "One-off"
            },
            {
              "value": "none",
              "label": "None"
            }
          ]
        },
        {
          "name": "renewal",
          "label": "Renewal date",
          "type": "date"
        },
        {
          "name": "owner",
          "label": "Licence owner",
          "type": "user"
        },
        {
          "name": "company",
          "label": "Held by",
          "type": "select",
          "options": [
            "HN Group",
            "Horizon Network",
            "Horizon Media Group",
            "Horizon Holding Co",
            "Horizon Advertising",
            "Horizon Development"
          ],
          "filter": true
        },
        {
          "name": "account",
          "label": "Account reference",
          "type": "text",
          "max": 160,
          "internal": true
        },
        {
          "name": "notes",
          "label": "Notes",
          "type": "textarea",
          "max": 5000,
          "internal": true
        }
      ],
      "listFields": [
        "vendor",
        "seats",
        "renewal",
        "owner"
      ],
      "statuses": [
        {
          "id": "active",
          "label": "Active"
        },
        {
          "id": "renewal-due",
          "label": "Renewal due"
        },
        {
          "id": "expired",
          "label": "Expired"
        },
        {
          "id": "cancelled",
          "label": "Cancelled"
        }
      ],
      "empty": "No licences recorded yet."
    }
  ],
  "seedAuthor": "HN Group"
}
