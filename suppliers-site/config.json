{
  "engine": "service-suite",
  "id": "suppliers",
  "domain": "suppliers.hngroup.org.uk",
  "aliases": [],
  "port": 4960,
  "company": "group",
  "name": "HN Group Suppliers",
  "brand": "HN Group",
  "logo": "hn-group-wordmark",
  "staffOnly": true,
  "staffSignIn": "any",
  "staffLabel": "HN Group",
  "hero": {
    "eyebrow": "HN GROUP SUPPLIERS",
    "title": "Supplier management.",
    "lead": "The group’s supplier directory, with contacts, contracts and review status. Supplier bills come from the staff portal.",
    "actions": [
      {
        "label": "Suppliers",
        "href": "#/m/directory"
      }
    ]
  },
  "sections": [],
  "notices": [],
  "related": [],
  "providers": {},
  "accounts": null,
  "securityTxt": null,
  "brandkit": null,
  "tools": null,
  "privacy": "https://hngroup.org.uk/privacy",
  "footer": {
    "text": "HN Group brings together Horizon Network, Horizon Media Group and Horizon Holding Co.",
    "copyright": "HN Group Limited",
    "links": [
      {
        "label": "hngroup.org.uk",
        "url": "https://hngroup.org.uk"
      },
      {
        "label": "Support",
        "url": "https://support.hngroup.org.uk"
      },
      {
        "label": "Service status",
        "url": "https://status.hngroup.org.uk"
      },
      {
        "label": "All HN Group links",
        "url": "https://links.hngroup.org.uk"
      }
    ]
  },
  "storageLimitMb": 2048,
  "modules": [
    {
      "key": "directory",
      "type": "items",
      "title": "Suppliers",
      "view": "staff",
      "create": "manager",
      "manage": "admin",
      "comments": true,
      "display": "table",
      "singular": "supplier",
      "files": "manager",
      "filesTitle": "Contracts and documents",
      "intro": "Staff can view suppliers; administrators maintain the directory.",
      "fields": [
        {
          "name": "title",
          "label": "Supplier",
          "type": "text",
          "required": true,
          "max": 160
        },
        {
          "name": "category",
          "label": "Category",
          "type": "select",
          "filter": true,
          "options": [
            {
              "value": "hosting-infrastructure",
              "label": "Hosting & infrastructure"
            },
            {
              "value": "software",
              "label": "Software"
            },
            {
              "value": "hardware",
              "label": "Hardware"
            },
            {
              "value": "domains",
              "label": "Domains"
            },
            {
              "value": "professional-services",
              "label": "Professional services"
            },
            {
              "value": "marketing",
              "label": "Marketing"
            },
            {
              "value": "office",
              "label": "Office"
            },
            {
              "value": "other",
              "label": "Other"
            }
          ]
        },
        {
          "name": "website",
          "label": "Website",
          "type": "url"
        },
        {
          "name": "contact",
          "label": "Contact name",
          "type": "text",
          "max": 120
        },
        {
          "name": "contactEmail",
          "label": "Contact email",
          "type": "email",
          "internal": true
        },
        {
          "name": "phone",
          "label": "Phone",
          "type": "text",
          "max": 40,
          "internal": true
        },
        {
          "name": "usedBy",
          "label": "Used by",
          "type": "multiselect",
          "options": [
            "HN Group",
            "Horizon Network",
            "Horizon Media Group",
            "Horizon Holding Co",
            "Horizon Advertising",
            "Horizon Development"
          ]
        },
        {
          "name": "account",
          "label": "Account reference",
          "type": "text",
          "max": 120,
          "internal": true
        },
        {
          "name": "review",
          "label": "Next review",
          "type": "date"
        },
        {
          "name": "notes",
          "label": "Notes",
          "type": "textarea",
          "max": 5000,
          "internal": true
        }
      ],
      "listFields": [
        "category",
        "contact",
        "review"
      ],
      "statuses": [
        {
          "id": "active",
          "label": "Active"
        },
        {
          "id": "under-review",
          "label": "Under review"
        },
        {
          "id": "inactive",
          "label": "Inactive"
        }
      ],
      "empty": "No suppliers recorded yet."
    },
    {
      "key": "bills",
      "type": "bridge",
      "title": "Supplier bills",
      "nav": "Bills",
      "intro": "Supplier bills recorded in the staff portal (payroll & finance permission required).",
      "portalUrl": "https://staff.hngroup.org.uk/bills",
      "load": {
        "path": "/api/bills"
      },
      "views": [
        {
          "id": "bills",
          "label": "Bills",
          "items": "bills",
          "columns": [
            {
              "field": "supplier",
              "label": "Supplier"
            },
            {
              "field": "reference",
              "label": "Reference"
            },
            {
              "field": "amount",
              "label": "Amount",
              "format": "pounds"
            },
            {
              "field": "dueDate",
              "label": "Due",
              "format": "date"
            },
            {
              "field": "repeatLabel",
              "label": "Repeats"
            },
            {
              "field": "status",
              "label": "Status",
              "format": "status"
            }
          ],
          "empty": "No bills, or your account does not have payroll & finance permission."
        }
      ],
      "forms": []
    }
  ],
  "seedAuthor": "HN Group"
}
