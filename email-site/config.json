              "label": "Getting started"
            },
            {
              "value": "mobile-devices",
              "label": "Mobile devices"
            },
            {
              "value": "security",
              "label": "Security"
            },
            {
              "value": "troubleshooting",
              "label": "Troubleshooting"
            },
            {
              "value": "other",
              "label": "Other"
            }
          ],
          "filter": true
        },
        {
          "name": "body",
          "label": "Guide",
          "type": "textarea",
          "max": 20000
        }
      ],
      "listFields": [
        "category"
      ],
      "empty": "No email guides have been published yet."
    },
    {
      "key": "help",
      "type": "items",
      "title": "Email help requests",
      "view": "staff",
      "create": "staff",
      "manage": "admin",
      "comments": true,
      "display": "table",
      "singular": "request",
      "cta": "Request help",
      "scope": "own",
      "intro": "Sign in with your staff account to ask for help. You can see your own requests; administrators handle them.",
      "fields": [
        {
          "name": "title",
          "label": "Subject",
          "type": "text",
          "required": true,
          "max": 160
        },
        {
          "name": "category",
          "label": "Topic",
          "type": "select",
          "required": true,
          "filter": true,
          "options": [
            {
              "value": "access-or-sign-in",
              "label": "Access or sign-in"
            },
            {
              "value": "new-mailbox",
              "label": "New mailbox"
            },
            {
              "value": "alias-or-forwarding",
              "label": "Alias or forwarding"
            },
            {
              "value": "sending-or-receiving-problem",
              "label": "Sending or receiving problem"
            },
            {
              "value": "suspected-phishing",
              "label": "Suspected phishing"
            },
            {
              "value": "other",
              "label": "Other"
            }
          ]
        },
        {
          "name": "address",
          "label": "Email address concerned",
          "type": "email"
        },
        {
          "name": "body",
          "label": "Details",
          "type": "textarea",
          "max": 20000
        }
      ],
      "listFields": [
        "category",
        "address"
      ],
      "statuses": [
        {
          "id": "open",
          "label": "Open"
        },
        {
          "id": "in-progress",
          "label": "In progress"
        },
        {
          "id": "resolved",
          "label": "Resolved"
        },
        {
          "id": "closed",
          "label": "Closed"
        }
      ],
      "empty": "No help requests yet."
