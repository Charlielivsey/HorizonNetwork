{
  "engine": "service-suite",
  "id": "bookings",
  "domain": "bookings.hngroup.org.uk",
  "aliases": [],
  "port": 4930,
  "company": "group",
  "name": "HN Group Bookings",
  "brand": "HN Group",
  "logo": "hn-group-wordmark",
  "staffOnly": false,
  "staffSignIn": "admin",
  "staffLabel": "HN Group",
  "hero": {
    "eyebrow": "HN GROUP BOOKINGS",
    "title": "Book an appointment.",
    "lead": "Choose an appointment type and a time that suits you. Times are shown in UK time.",
    "actions": [
      {
        "label": "Book an appointment",
        "href": "#/m/types"
      },
      {
        "label": "Manage a booking",
        "href": "#/ref"
      }
    ]
  },
  "sections": [],
  "notices": [
    {
      "title": "No automatic emails.",
      "text": "This website does not send email notifications. Keep your private reference to check progress and read replies here.",
      "email": false
    }
  ],
  "related": [],
  "providers": {},
  "accounts": null,
  "securityTxt": null,
  "brandkit": null,
  "tools": null,
  "privacy": "https://hngroup.org.uk/privacy",
  "footer": {
    "text": "HN Group brings together Horizon Network, Horizon Media Group and Horizon Holding Co.",
    "copyright": "HN Group Limited",
    "links": [
      {
        "label": "hngroup.org.uk",
        "url": "https://hngroup.org.uk"
      },
      {
        "label": "Support",
        "url": "https://support.hngroup.org.uk"
      },
      {
        "label": "Service status",
        "url": "https://status.hngroup.org.uk"
      },
      {
        "label": "All HN Group links",
        "url": "https://links.hngroup.org.uk"
      }
    ]
  },
  "storageLimitMb": 2048,
  "modules": [
    {
      "key": "types",
      "type": "items",
      "title": "Appointment types",
      "view": "public",
      "create": "manager",
      "manage": "admin",
      "publish": true,
      "comments": false,
      "singular": "appointment type",
      "intro": "Choose what you would like to book.",
      "fields": [
        {
          "name": "title",
          "label": "Appointment",
          "type": "text",
          "required": true,
          "max": 160
        },
        {
          "name": "summary",
          "label": "Summary",
          "type": "text",
          "max": 300
        },
        {
          "name": "duration",
          "label": "Length (minutes)",
          "type": "number",
          "required": true,
          "min": 10,
          "max": 480
        },
        {
          "name": "days",
          "label": "Available days",
          "type": "multiselect",
          "required": true,
          "options": [
            {
              "value": "mon",
              "label": "Monday"
            },
            {
              "value": "tue",
              "label": "Tuesday"
            },
            {
              "value": "wed",
              "label": "Wednesday"
            },
            {
              "value": "thu",
              "label": "Thursday"
            },
            {
              "value": "fri",
              "label": "Friday"
            },
            {
              "value": "sat",
              "label": "Saturday"
            },
            {
              "value": "sun",
              "label": "Sunday"
            }
          ]
        },
        {
          "name": "start",
          "label": "Daily start (UK time)",
          "type": "time",
          "required": true
        },
        {
          "name": "end",
          "label": "Daily end (UK time)",
          "type": "time",
          "required": true
        },
        {
          "name": "lead",
          "label": "Minimum notice (hours)",
          "type": "number",
          "min": 0,
          "max": 720
        },
        {
          "name": "horizon",
          "label": "Bookable up to (days ahead)",
          "type": "number",
          "min": 1,
          "max": 365
        },
        {
          "name": "location",
          "label": "Where",
          "type": "text",
          "max": 160
        },
        {
          "name": "body",
          "label": "Details",
          "type": "textarea",
          "max": 20000
        }
      ],
      "listFields": [
        "duration",
        "location"
      ],
      "empty": "No appointments are available to book yet."
    },
    {
      "key": "appointments",
      "type": "items",
      "title": "Bookings",
      "view": "manager",
      "create": "public",
      "manage": "admin",
      "reference": true,
      "comments": true,
      "consent": "I understand HN Group will use these details to respond, as described in the HN Group privacy notice.",
      "scope": "own",
      "singular": "booking",
      "slots": true,
      "parent": {
        "module": "types",
        "label": "Appointment",
        "cta": "Book"
      },
      "cancellable": [
        "requested",
        "confirmed"
      ],
      "successTitle": "Booking requested",
      "successText": "Your booking request has been recorded. We will confirm it here — check with your private reference.",
      "fields": [
        {
          "name": "date",
          "label": "Date",
          "type": "date",
          "required": true
        },
        {
          "name": "time",
          "label": "Time",
          "type": "time",
          "required": true
        },
        {
          "name": "name",
          "label": "Your name",
          "type": "text",
          "required": true,
          "max": 120,
          "autocomplete": "name"
        },
        {
          "name": "email",
          "label": "Email",
          "type": "email",
          "required": true,
          "contact": true,
          "autocomplete": "email"
        },
        {
          "name": "phone",
          "label": "Phone (optional)",
          "type": "text",
          "max": 40,
          "contact": true
        },
        {
          "name": "notes",
          "label": "Anything we should know?",
          "type": "textarea",
          "max": 2000
        }
      ],
      "listFields": [
        "date",
        "time",
        "name"
      ],
      "statuses": [
        {
          "id": "requested",
          "label": "Requested"
        },
        {
          "id": "confirmed",
          "label": "Confirmed"
        },
        {
          "id": "completed",
          "label": "Completed"
        },
        {
          "id": "cancelled",
          "label": "Cancelled"
        }
      ],
      "empty": "Submissions are private to the person who sent them and our team. Use the button above to send one, or check an existing one with your private reference."
    }
  ],
  "seedAuthor": "HN Group"
}
