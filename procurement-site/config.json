  "company": "group",
  "name": "HN Group Procurement",
  "brand": "HN Group",
  "logo": "hn-group-wordmark",
  "staffOnly": true,
  "staffSignIn": "any",
  "staffLabel": "HN Group",
  "hero": {
    "eyebrow": "HN GROUP PROCUREMENT",
    "title": "Purchase requests and approvals.",
    "lead": "Request a purchase, get it approved by an administrator, then record it as a bill in the staff portal so finance tracks it in one place.",
    "actions": [
      {
        "label": "New request",
        "href": "#/m/requests/new"
      },
      {
        "label": "Requests",
        "href": "#/m/requests"
      }
    ]
  },
  "sections": [],
  "notices": [],
  "related": [],
  "providers": {},
  "accounts": null,
  "securityTxt": null,
  "brandkit": null,
  "tools": null,
  "privacy": "https://hngroup.org.uk/privacy",
  "footer": {
    "text": "HN Group brings together Horizon Network, Horizon Media Group and Horizon Holding Co.",
    "copyright": "HN Group Limited",
    "links": [
      {
        "label": "hngroup.org.uk",
        "url": "https://hngroup.org.uk"
      },
      {
        "label": "Support",
        "url": "https://support.hngroup.org.uk"
      },
      {
        "label": "Service status",
        "url": "https://status.hngroup.org.uk"
      },
      {
        "label": "All HN Group links",
        "url": "https://links.hngroup.org.uk"
      }
    ]
  },
  "storageLimitMb": 2048,
  "modules": [
    {
      "key": "requests",
      "type": "items",
      "title": "Purchase requests",
      "view": "staff",
      "create": "staff",
      "manage": "admin",
      "comments": true,
      "display": "table",
      "singular": "purchase request",
      "cta": "New request",
      "scope": "own",
      "portalBill": {
        "supplier": "supplier",
        "amount": "amount"
      },
      "cancellable": [
        "submitted"
      ],
      "approval": {
        "decisions": [
          "approved",
          "rejected"
        ],
        "by": "admin",
        "noSelf": true
      },
      "transitions": {
        "submitted": [
          "approved",
          "rejected"
        ],
        "approved": [
          "ordered",
          "cancelled"
        ],
        "ordered": [
          "received"
        ],
        "received": [],
        "rejected": [],
        "cancelled": []
      },
      "intro": "You see your own requests; administrators see all and approve them. No one can approve their own request.",
      "fields": [
        {
          "name": "title",
          "label": "What is needed",
          "type": "text",
          "required": true,
          "max": 160
        },
        {
          "name": "supplier",
          "label": "Supplier",
          "type": "text",
          "required": true,
          "max": 120
        },
        {
          "name": "amount",
          "label": "Cost (£)",
          "type": "money",
          "required": true
        },
        {
          "name": "company",
          "label": "Paid by",
          "type": "select",
          "required": true,
          "options": [
            "HN Group",
            "Horizon Network",
            "Horizon Media Group",
            "Horizon Holding Co",
            "Horizon Advertising",
            "Horizon Development"
          ],
          "filter": true
        },
        {
          "name": "needed",
          "label": "Needed by",
          "type": "date"
        },
        {
          "name": "link",
          "label": "Product or quote link",
          "type": "url"
        },
        {
          "name": "justification",
          "label": "Why it is needed",
          "type": "textarea",
          "required": true,
          "max": 5000
        }
      ],
      "listFields": [
        "supplier",
        "amount",
        "company",
        "needed"
      ],
      "statuses": [
        {
          "id": "submitted",
          "label": "Submitted"
        },
        {
          "id": "approved",
          "label": "Approved"
        },
        {
          "id": "rejected",
          "label": "Rejected"
        },
        {
          "id": "ordered",
          "label": "Ordered"
        },
        {
          "id": "received",
          "label": "Received"
        },
        {
          "id": "cancelled",
          "label": "Cancelled"
        }
      ],
      "empty": "No purchase requests yet."
    },
    {
      "key": "bills",
      "type": "bridge",
      "title": "Supplier bills",
      "nav": "Bills",
      "intro": "Supplier bills recorded in the staff portal (payroll & finance permission required).",
      "portalUrl": "https://staff.hngroup.org.uk/bills",
      "load": {
        "path": "/api/bills"
      },
      "views": [
        {
          "id": "bills",
          "label": "Bills",
          "items": "bills",
          "columns": [
            {
              "field": "supplier",
              "label": "Supplier"
            },
            {
              "field": "reference",
              "label": "Reference"
            },
            {
              "field": "amount",
              "label": "Amount",
              "format": "pounds"
            },
            {
              "field": "dueDate",
              "label": "Due",
              "format": "date"
            },
            {
              "field": "repeatLabel",
              "label": "Repeats"
            },
            {
              "field": "status",
              "label": "Status",
              "format": "status"
            }
          ],
          "empty": "No bills, or your account does not have payroll & finance permission."
        }
      ],
      "forms": []
    }
  ],
  "seedAuthor": "HN Group"
}
