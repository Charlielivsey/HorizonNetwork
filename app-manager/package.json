{
 "name": "hn-group-app-manager",
 "version": "3.1.1",
 "productName": "HN Group App Manager",
 "private": true,
 "description": "Install, update, repair and look after HN Group desktop apps on macOS, Windows and Linux",
 "author": "HN Group",
 "license": "UNLICENSED",
 "main": "src/main.cjs",
 "desktopName": "hn-group-app-manager.desktop",
 "scripts": {
  "start": "electron .",
  "test": "node --test test/*.test.cjs",
  "test:mac-swap": "node test/mac-swap.cjs",
  "test:desktop": "node test/desktop.cjs",
  "icons": "node scripts/icons.cjs",
  "build:mac": "electron-builder --mac --universal --publish never",
  "build:win": "electron-builder --win --x64 --publish never",
  "build:linux": "electron-builder --linux AppImage --x64 --publish never"
 },
 "devDependencies": {
  "electron": "44.9.0",
  "electron-builder": "26.15.3",
  "playwright": "1.61.1",
  "@resvg/resvg-js": "2.6.2",
  "png-to-ico": "3.0.1"
 },
 "build": {
  "appId": "uk.org.hngroup.appmanager",
  "productName": "HN Group App Manager",
  "executableName": "HN Group App Manager",
  "asar": true,
  "directories": {
   "output": "dist"
  },
  "files": [
   "src/**",
   "!src/core/fake.cjs",
   "!src/core/test-fixtures.cjs",
   "ui/**",
   "package.json"
  ],
  "artifactName": "HN-Group-App-Manager-${version}-${os}-${arch}.${ext}",
  "mac": {
   "target": [
    "dmg",
    "zip"
   ],
   "category": "public.app-category.utilities",
   "icon": "build/icon.png",
   "identity": null
  },
  "win": {
   "target": [
    "nsis"
   ],
   "icon": "build/icon.ico"
  },
  "nsis": {
   "oneClick": false,
   "perMachine": false,
   "allowToChangeInstallationDirectory": true,
   "createDesktopShortcut": true,
   "deleteAppDataOnUninstall": false
  },
  "npmRebuild": false,
  "afterPack": "scripts/after-pack.cjs",
  "linux": {
   "target": [
    "AppImage"
   ],
   "category": "Utility",
   "icon": "build/icon.png",
   "executableName": "hn-group-app-manager",
   "synopsis": "Install and update HN Group apps",
   "description": "Install, update and look after HN Browser and HN Secure Network.",
   "desktop": {
    "entry": {
     "Name": "HN Group App Manager",
     "Categories": "Utility;System;",
     "Keywords": "HN;Apps;Updates;"
    }
   },
   "syncDesktopName": true
  },
  "appImage": {
   "artifactName": "HN-Group-App-Manager-${version}-linux-x86_64.AppImage",
   "executableArgs": []
  },
  "publish": []
 }
}
