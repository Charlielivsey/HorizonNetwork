{
  "engine": "service-suite",
  "id": "developers",
  "domain": "developers.hngroup.org.uk",
  "aliases": [],
  "port": 5010,
  "company": "group",
  "name": "HN Group Developers",
  "brand": "HN Group",
  "logo": "hn-group-wordmark",
  "staffOnly": false,
  "staffSignIn": "admin",
  "staffLabel": "HN Group",
  "hero": {
    "eyebrow": "HN GROUP DEVELOPERS",
    "title": "Developer documentation.",
    "lead": "Guides, references and API information for building with HN Group services. Documentation appears here as it is published.",
    "actions": [
      {
        "label": "Documentation",
        "href": "#/m/docs"
      },
      {
        "label": "Ask a question",
        "href": "#/m/questions/new"
      }
    ]
  },
  "sections": [],
  "notices": [
    {
      "title": "No automatic emails.",
      "text": "This website does not send email notifications. Keep your private reference to check progress and read replies here.",
      "email": false
    }
  ],
  "related": [],
  "providers": {},
  "accounts": null,
  "securityTxt": null,
  "brandkit": null,
  "tools": null,
  "privacy": "https://hngroup.org.uk/privacy",
  "footer": {
    "text": "HN Group brings together Horizon Network, Horizon Media Group and Horizon Holding Co.",
    "copyright": "HN Group Limited",
    "links": [
      {
        "label": "hngroup.org.uk",
        "url": "https://hngroup.org.uk"
      },
      {
        "label": "Support",
        "url": "https://support.hngroup.org.uk"
      },
      {
        "label": "Service status",
        "url": "https://status.hngroup.org.uk"
      },
      {
        "label": "All HN Group links",
        "url": "https://links.hngroup.org.uk"
      }
    ]
  },
  "storageLimitMb": 2048,
  "modules": [
    {
      "key": "docs",
      "type": "items",
      "title": "Documentation",
      "view": "public",
      "create": "manager",
      "manage": "admin",
      "publish": true,
      "comments": false,
      "singular": "document",
      "files": "manager",
      "fields": [
        {
          "name": "title",
          "label": "Title",
          "type": "text",
          "required": true,
          "max": 160
        },
        {
          "name": "category",
          "label": "Section",
          "type": "select",
          "filter": true,
          "options": [
            {
              "value": "getting-started",
              "label": "Getting started"
            },
            {
              "value": "guides",
              "label": "Guides"
            },
            {
              "value": "api-reference",
              "label": "API reference"
            },
            {
              "value": "changelog",
              "label": "Changelog"
            }
          ]
        },
        {
          "name": "version",
          "label": "Applies to version",
          "type": "text",
          "max": 40
        },
        {
          "name": "summary",
          "label": "Summary",
          "type": "text",
          "max": 300
        },
        {
          "name": "body",
          "label": "Content",
          "type": "textarea",
          "max": 20000
        }
      ],
      "listFields": [
        "category",
        "version"
      ],
      "empty": "No developer documentation has been published yet. API documentation will be published here when it is available."
    },
    {
      "key": "questions",
      "type": "items",
      "title": "Developer questions",
      "view": "manager",
      "create": "public",
      "manage": "admin",
      "reference": true,
      "comments": true,
      "consent": "I understand HN Group will use these details to respond, as described in the HN Group privacy notice.",
      "scope": "own",
      "singular": "question",
      "cta": "Ask a question",
      "fields": [
        {
          "name": "name",
          "label": "Your name",
          "type": "text",
          "required": true,
          "max": 120,
          "autocomplete": "name"
        },
        {
          "name": "email",
          "label": "Email",
          "type": "email",
          "required": true,
          "contact": true,
          "autocomplete": "email"
        },
        {
          "name": "title",
          "label": "Subject",
          "type": "text",
          "required": true,
          "max": 160
        },
        {
          "name": "body",
          "label": "Your question",
          "type": "textarea",
          "max": 20000
        }
      ],
      "statuses": [
        {
          "id": "new",
          "label": "New"
        },
        {
          "id": "in-progress",
          "label": "In progress"
        },
        {
          "id": "resolved",
          "label": "Resolved"
        },
        {
          "id": "closed",
          "label": "Closed"
        }
      ],
      "empty": "Submissions are private to the person who sent them and our team. Use the button above to send one, or check an existing one with your private reference."
    }
  ],
  "seedAuthor": "HN Group"
}
