{
  "engine": "service-suite",
  "id": "projects",
  "domain": "projects.hngroup.org.uk",
  "aliases": [],
  "port": 4810,
  "company": "group",
  "name": "HN Group Projects",
  "brand": "HN Group",
  "logo": "hn-group-wordmark",
  "staffOnly": true,
  "staffSignIn": "any",
  "staffLabel": "HN Group",
  "hero": {
    "eyebrow": "HN GROUP PROJECTS",
    "title": "Projects, tasks and milestones.",
    "lead": "Plan work across the group: create projects, assign tasks to colleagues and track milestones.",
    "actions": [
      {
        "label": "View projects",
        "href": "#/m/projects"
      }
    ]
  },
  "sections": [],
  "notices": [],
  "related": [],
  "providers": {},
  "accounts": null,
  "securityTxt": null,
  "brandkit": null,
  "tools": null,
  "privacy": "https://hngroup.org.uk/privacy",
  "footer": {
    "text": "HN Group brings together Horizon Network, Horizon Media Group and Horizon Holding Co.",
    "copyright": "HN Group Limited",
    "links": [
      {
        "label": "hngroup.org.uk",
        "url": "https://hngroup.org.uk"
      },
      {
        "label": "Support",
        "url": "https://support.hngroup.org.uk"
      },
      {
        "label": "Service status",
        "url": "https://status.hngroup.org.uk"
      },
      {
        "label": "All HN Group links",
        "url": "https://links.hngroup.org.uk"
      }
    ]
  },
  "storageLimitMb": 2048,
  "modules": [
    {
      "key": "projects",
      "type": "items",
      "title": "Projects",
      "view": "staff",
      "create": "staff",
      "manage": "staff",
      "comments": true,
      "display": "cards",
      "singular": "project",
      "cta": "New project",
      "intro": "All group projects. Open a project to add tasks and milestones.",
      "files": "creator",
      "fields": [
        {
          "name": "title",
          "label": "Project name",
          "type": "text",
          "required": true,
          "max": 160
        },
        {
          "name": "summary",
          "label": "Summary",
          "type": "text",
          "max": 300
        },
        {
          "name": "company",
          "label": "Company",
          "type": "select",
          "options": [
            "HN Group",
            "Horizon Network",
            "Horizon Media Group",
            "Horizon Holding Co",
            "Horizon Advertising",
            "Horizon Development"
          ],
          "filter": true
        },
        {
          "name": "owner",
          "label": "Project lead",
          "type": "user"
        },
        {
          "name": "start",
          "label": "Start date",
          "type": "date"
        },
        {
          "name": "due",
          "label": "Target date",
          "type": "date"
        },
        {
          "name": "body",
          "label": "Description",
          "type": "textarea",
          "max": 20000
        }
      ],
      "listFields": [
        "company",
        "owner",
        "due"
      ],
      "statuses": [
        {
          "id": "planning",
          "label": "Planning"
        },
        {
          "id": "active",
          "label": "Active"
        },
        {
          "id": "on-hold",
          "label": "On hold"
        },
        {
          "id": "completed",
          "label": "Completed"
        },
        {
          "id": "cancelled",
          "label": "Cancelled"
        }
      ],
      "empty": "No projects yet. Create the first one."
    },
    {
      "key": "tasks",
      "type": "items",
      "title": "Tasks",
      "view": "staff",
      "create": "staff",
      "manage": "staff",
      "comments": true,
      "display": "table",
      "singular": "task",
      "parent": {
        "module": "projects",
        "label": "Project",
        "cta": "Add task"
      },
      "intro": "Every task across all projects.",
      "fields": [
        {
          "name": "title",
          "label": "Task",
          "type": "text",
          "required": true,
          "max": 160
        },
        {
          "name": "assignee",
          "label": "Assigned to",
          "type": "user"
        },
        {
          "name": "due",
          "label": "Due",
          "type": "date"
        },
        {
          "name": "priority",
          "label": "Priority",
          "type": "select",
          "options": [
            {
              "value": "low",
              "label": "Low"
            },
            {
              "value": "normal",
              "label": "Normal"
            },
            {
              "value": "high",
              "label": "High"
            },
            {
              "value": "urgent",
              "label": "Urgent"
            }
          ],
          "filter": true
        },
        {
          "name": "notes",
          "label": "Notes",
          "type": "textarea",
          "max": 5000
        }
      ],
      "listFields": [
        "assignee",
        "due",
        "priority"
      ],
      "statuses": [
        {
          "id": "todo",
          "label": "To do"
        },
        {
          "id": "in-progress",
          "label": "In progress"
        },
        {
          "id": "blocked",
          "label": "Blocked"
        },
        {
          "id": "done",
          "label": "Done"
        },
        {
          "id": "cancelled",
          "label": "Cancelled"
        }
      ],
      "empty": "No tasks yet. Open a project and add one."
    },
    {
      "key": "milestones",
      "type": "items",
      "title": "Milestones",
      "view": "staff",
      "create": "staff",
      "manage": "staff",
      "comments": true,
      "display": "table",
      "singular": "milestone",
      "parent": {
        "module": "projects",
        "label": "Project",
        "cta": "Add milestone"
      },
      "fields": [
        {
          "name": "title",
          "label": "Milestone",
          "type": "text",
          "required": true,
          "max": 160
        },
        {
          "name": "due",
          "label": "Due",
          "type": "date",
          "required": true
        },
        {
          "name": "owner",
          "label": "Owner",
          "type": "user"
        },
        {
          "name": "notes",
          "label": "Notes",
          "type": "textarea",
          "max": 5000
        }
      ],
      "listFields": [
        "due",
        "owner"
      ],
      "statuses": [
        {
          "id": "upcoming",
          "label": "Upcoming"
        },
        {
          "id": "achieved",
          "label": "Achieved"
        },
        {
          "id": "missed",
          "label": "Missed"
        },
        {
          "id": "cancelled",
          "label": "Cancelled"
        }
      ],
      "empty": "No milestones yet."
    }
  ],
  "seedAuthor": "HN Group"
}
