{
  "engine": "service-suite",
  "id": "competitions",
  "domain": "competitions.hngroup.org.uk",
  "aliases": [],
  "port": 5070,
  "company": "group",
  "name": "HN Group Competitions",
  "brand": "HN Group",
  "logo": "hn-group-wordmark",
  "staffOnly": false,
  "staffSignIn": "admin",
  "staffLabel": "HN Group",
  "hero": {
    "eyebrow": "HN GROUP COMPETITIONS",
    "title": "Competitions.",
    "lead": "Enter HN Group competitions. Each competition lists its closing date, prize and rules.",
    "actions": [
      {
        "label": "Open competitions",
        "href": "#/m/competitions"
      }
    ]
  },
  "sections": [],
  "notices": [
    {
      "title": "No automatic emails.",
      "text": "This website does not send email notifications. Keep your private reference to check progress and read replies here.",
      "email": false
    }
  ],
  "related": [],
  "providers": {},
  "accounts": null,
  "securityTxt": null,
  "brandkit": null,
  "tools": null,
  "privacy": "https://hngroup.org.uk/privacy",
  "footer": {
    "text": "HN Group brings together Horizon Network, Horizon Media Group and Horizon Holding Co.",
    "copyright": "HN Group Limited",
    "links": [
      {
        "label": "hngroup.org.uk",
        "url": "https://hngroup.org.uk"
      },
      {
        "label": "Support",
        "url": "https://support.hngroup.org.uk"
      },
      {
        "label": "Service status",
        "url": "https://status.hngroup.org.uk"
      },
      {
        "label": "All HN Group links",
        "url": "https://links.hngroup.org.uk"
      }
    ]
  },
  "storageLimitMb": 2048,
  "modules": [
    {
      "key": "competitions",
      "type": "items",
      "title": "Competitions",
      "view": "public",
      "create": "manager",
      "manage": "admin",
      "publish": true,
      "comments": false,
      "singular": "competition",
      "fields": [
        {
          "name": "title",
          "label": "Competition",
          "type": "text",
          "required": true,
          "max": 160
        },
        {
          "name": "summary",
          "label": "Summary",
          "type": "text",
          "max": 300
        },
        {
          "name": "opens",
          "label": "Opens",
          "type": "date"
        },
        {
          "name": "closes",
          "label": "Closes",
          "type": "datetime",
          "required": true
        },
        {
          "name": "prize",
          "label": "Prize",
          "type": "text",
          "max": 200
        },
        {
          "name": "eligibility",
          "label": "Who can enter",
          "type": "textarea",
          "max": 3000
        },
        {
          "name": "body",
          "label": "Rules",
          "type": "textarea",
          "max": 20000
        }
      ],
      "listFields": [
        "closes",
        "prize"
      ],
      "empty": "There are no competitions open at the moment."
    },
    {
      "key": "entries",
      "type": "items",
      "title": "Entries",
      "view": "manager",
      "create": "public",
      "manage": "admin",
      "reference": true,
      "comments": true,
      "consent": "I understand HN Group will use these details to respond, as described in the HN Group privacy notice.",
      "scope": "own",
      "singular": "entry",
      "parent": {
        "module": "competitions",
        "label": "Competition",
        "cta": "Enter",
        "closes": "closes",
        "unique": "email"
      },
      "files": "creator",
      "fileLabel": "Attach your entry (optional, up to 10 MB)",
      "fileTypes": [
        "pdf",
        "png",
        "jpg",
        "jpeg",
        "webp",
        "txt",
        "zip",
        "docx",
        "pptx",
        "mp3",
        "mp4"
      ],
      "fields": [
        {
          "name": "name",
          "label": "Your name",
          "type": "text",
          "required": true,
          "max": 120,
          "autocomplete": "name"
        },
        {
          "name": "email",
          "label": "Email",
          "type": "email",
          "required": true,
          "contact": true,
          "autocomplete": "email"
        },
        {
          "name": "entry",
          "label": "Your entry",
          "type": "textarea",
          "required": true,
          "max": 10000
        },
        {
          "name": "link",
          "label": "Link (optional)",
          "type": "url"
        },
        {
          "name": "rules",
          "label": "I have read and accept the competition rules",
          "type": "checkbox",
          "required": true
        }
      ],
      "statuses": [
        {
          "id": "received",
          "label": "Received"
        },
        {
          "id": "shortlisted",
          "label": "Shortlisted"
        },
        {
          "id": "winner",
          "label": "Winner"
        },
        {
          "id": "not-selected",
          "label": "Not selected"
        },
        {
          "id": "withdrawn",
          "label": "Withdrawn"
        }
      ],
      "cancellable": [
        "received"
      ],
      "empty": "Submissions are private to the person who sent them and our team. Use the button above to send one, or check an existing one with your private reference."
    }
  ],
  "seedAuthor": "HN Group"
}
