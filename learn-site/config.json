{
  "engine": "service-suite",
  "id": "learn",
  "domain": "learn.hngroup.org.uk",
  "aliases": [],
  "port": 4890,
  "company": "group",
  "name": "HN Group Learn",
  "brand": "HN Group",
  "logo": "hn-group-wordmark",
  "staffOnly": true,
  "staffSignIn": "any",
  "staffLabel": "HN Group",
  "hero": {
    "eyebrow": "HN GROUP LEARN",
    "title": "Learning for every team.",
    "lead": "Courses for HN Group staff. Completing a course adds it to your training records in the staff portal automatically.",
    "actions": [
      {
        "label": "Browse courses",
        "href": "#/m/courses"
      },
      {
        "label": "My training records",
        "href": "#/bridge/training"
      }
    ]
  },
  "sections": [],
  "notices": [],
  "related": [],
  "providers": {},
  "accounts": null,
  "securityTxt": null,
  "brandkit": null,
  "tools": null,
  "privacy": "https://hngroup.org.uk/privacy",
  "footer": {
    "text": "HN Group brings together Horizon Network, Horizon Media Group and Horizon Holding Co.",
    "copyright": "HN Group Limited",
    "links": [
      {
        "label": "hngroup.org.uk",
        "url": "https://hngroup.org.uk"
      },
      {
        "label": "Support",
        "url": "https://support.hngroup.org.uk"
      },
      {
        "label": "Service status",
        "url": "https://status.hngroup.org.uk"
      },
      {
        "label": "All HN Group links",
        "url": "https://links.hngroup.org.uk"
      }
    ]
  },
  "storageLimitMb": 2048,
  "modules": [
    {
      "key": "courses",
      "type": "items",
      "title": "Courses",
      "view": "staff",
      "create": "manager",
      "manage": "admin",
      "publish": true,
      "comments": false,
      "singular": "course",
      "defaultVisibility": "staff",
      "intro": "Courses published for staff.",
      "files": "manager",
      "completion": {
        "portal": true,
        "provider": "HN Group Learn"
      },
      "fields": [
        {
          "name": "title",
          "label": "Course",
          "type": "text",
          "required": true,
          "max": 160
        },
        {
          "name": "summary",
          "label": "Summary",
          "type": "text",
          "max": 300
        },
        {
          "name": "category",
          "label": "Category",
          "type": "select",
          "options": [
            {
              "value": "induction",
              "label": "Induction"
            },
            {
              "value": "security",
              "label": "Security"
            },
            {
              "value": "compliance",
              "label": "Compliance"
            },
            {
              "value": "technical",
              "label": "Technical"
            },
            {
              "value": "leadership",
              "label": "Leadership"
            },
            {
              "value": "customer",
              "label": "Customer"
            },
            {
              "value": "other",
              "label": "Other"
            }
          ],
          "filter": true
        },
        {
          "name": "duration",
          "label": "Time needed",
          "type": "text",
          "max": 60
        },
        {
          "name": "link",
          "label": "External course link",
          "type": "url"
        },
        {
          "name": "body",
          "label": "Course content",
          "type": "textarea",
          "max": 20000
        }
      ],
      "listFields": [
        "category",
        "duration"
      ],
      "empty": "No courses have been published yet."
    },
    {
      "key": "training",
      "type": "bridge",
      "title": "Training records",
      "nav": "Records",
      "intro": "Your training and certificates, shared with the staff portal. HR can verify records and set required courses.",
      "portalUrl": "https://staff.hngroup.org.uk/training",
      "load": {
        "path": "/api/training"
      },
      "views": [
        {
          "id": "mine",
          "label": "My training",
          "items": "mine",
          "columns": [
            {
              "field": "course",
              "label": "Course"
            },
            {
              "field": "provider",
              "label": "Provider"
            },
            {
              "field": "completedOn",
              "label": "Completed",
              "format": "date"
            },
            {
              "field": "expiresOn",
              "label": "Expires",
              "format": "date"
            },
            {
              "field": "state",
              "label": "State",
              "format": "status"
            },
            {
              "field": "verified",
              "label": "Verified",
              "format": "bool"
            }
          ],
          "download": {
            "path": "/api/training/{id}/certificate",
            "when": "certificate",
            "label": "Certificate"
          },
          "actions": [
            {
              "id": "delete",
              "label": "Delete",
              "path": "/api/training/{id}/delete",
              "when": "canEdit",
              "confirm": "Delete this training record?",
              "danger": true
            }
          ],
          "empty": "No training records yet."
        },
        {
          "id": "required",
          "label": "Required courses",
          "items": "required",
          "columns": [
            {
              "field": "course",
              "label": "Course"
            },
            {
              "field": "company",
              "label": "For"
            }
          ],
          "actions": [
            {
              "id": "remove",
              "label": "Remove",
              "path": "/api/training/required/{id}/delete",
              "when": "id",
              "confirm": "Remove this required course?",
              "danger": true
            }
          ],
          "empty": "No courses are currently required."
        },
        {
          "id": "all",
          "label": "Everyone (HR)",
          "items": "all",
          "when": "canManage",
          "columns": [
            {
              "field": "person.displayName",
              "label": "Person"
            },
            {
              "field": "course",
              "label": "Course"
            },
            {
              "field": "completedOn",
              "label": "Completed",
              "format": "date"
            },
            {
              "field": "expiresOn",
              "label": "Expires",
              "format": "date"
            },
            {
              "field": "state",
              "label": "State",
              "format": "status"
            },
            {
              "field": "verified",
              "label": "Verified",
              "format": "bool"
            }
          ],
          "download": {
            "path": "/api/training/{id}/certificate",
            "when": "certificate",
            "label": "Certificate"
          },
          "actions": [
            {
              "id": "verify",
              "label": "Verify",
              "path": "/api/training/{id}/verify",
              "when": "verified",
              "equals": false
            }
          ]
        }
      ],
      "forms": [
        {
          "id": "record",
          "label": "Add a training record",
          "path": "/api/training",
          "upload": {
            "header": "x-training",
            "required": false,
            "label": "Certificate (PDF or image, optional)",
            "accept": ".pdf,.jpg,.jpeg,.png"
          },
          "fields": [
            {
              "name": "course",
              "label": "Course",
              "type": "text",
              "required": true,
              "max": 120
            },
            {
              "name": "provider",
              "label": "Provider",
              "type": "text",
              "max": 120
            },
            {
              "name": "completedOn",
              "label": "Completed on",
              "type": "date",
              "required": true
            },
            {
              "name": "expiresOn",
              "label": "Expires on",
              "type": "date"
            },
            {
              "name": "note",
              "label": "Note",
              "type": "text",
              "max": 500,
              "wide": true
            }
          ]
        },
        {
          "id": "required",
          "label": "Require a course (HR)",
          "path": "/api/training/required",
          "when": "canManage",
          "fields": [
            {
              "name": "course",
              "label": "Course",
              "type": "text",
              "required": true,
              "max": 120
            },
            {
              "name": "company",
              "label": "Required for",
              "type": "select",
              "options": [
                {
                  "value": "",
                  "label": "Everyone"
                },
                {
                  "value": "HN Group",
                  "label": "HN Group"
                },
                {
                  "value": "Horizon Network",
                  "label": "Horizon Network"
                },
                {
                  "value": "Horizon Advertising",
                  "label": "Horizon Advertising"
                },
                {
                  "value": "Horizon Development",
                  "label": "Horizon Development"
                },
                {
                  "value": "Horizon Media Group",
                  "label": "Horizon Media Group"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "seedAuthor": "HN Group"
}
