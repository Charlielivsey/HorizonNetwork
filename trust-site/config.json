{
  "engine": "service-suite",
  "id": "trust",
  "domain": "trust.hngroup.org.uk",
  "aliases": [],
  "port": 4880,
  "company": "group",
  "name": "HN Group Trust Centre",
  "brand": "HN Group",
  "logo": "hn-group-wordmark",
  "staffOnly": false,
  "staffSignIn": "admin",
  "staffLabel": "HN Group",
  "hero": {
    "eyebrow": "HN GROUP TRUST CENTRE",
    "title": "Trust and policies.",
    "lead": "Approved HN Group policies and information about how we look after data and services, in one place.",
    "actions": [
      {
        "label": "Policies",
        "href": "#/m/policies"
      },
      {
        "label": "Ask a question",
        "href": "#/m/questions/new"
      }
    ]
  },
  "sections": [],
  "notices": [
    {
      "title": "No automatic emails.",
      "text": "This website does not send email notifications. Keep your private reference to check progress and read replies here.",
      "email": false
    }
  ],
  "related": [
    {
      "label": "HN Group privacy notice",
      "url": "https://hngroup.org.uk/privacy",
      "text": "How HN Group handles personal information on hngroup.org.uk"
    },
    {
