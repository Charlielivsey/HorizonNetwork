      "url": "https://security.hngroup.org.uk",
      "text": "Report a security vulnerability"
    },
    {
      "label": "Service status",
      "url": "https://status.hngroup.org.uk",
      "text": "Live service status"
    }
  ],
  "providers": {},
  "accounts": null,
  "securityTxt": null,
  "brandkit": null,
  "tools": null,
  "privacy": "https://hngroup.org.uk/privacy",
  "footer": {
    "text": "HN Group brings together Horizon Network, Horizon Media Group and Horizon Holding Co.",
    "copyright": "HN Group Limited",
    "links": [
      {
        "label": "hngroup.org.uk",
        "url": "https://hngroup.org.uk"
      },
      {
        "label": "Support",
        "url": "https://support.hngroup.org.uk"
      },
      {
        "label": "Service status",
        "url": "https://status.hngroup.org.uk"
      },
      {
        "label": "All HN Group links",
        "url": "https://links.hngroup.org.uk"
      }
    ]
  },
  "storageLimitMb": 2048,
  "modules": [
    {
      "key": "policies",
      "type": "items",
      "title": "Policies",
      "view": "public",
      "create": "manager",
      "manage": "admin",
      "publish": true,
      "comments": false,
      "singular": "policy",
      "files": "manager",
      "fields": [
        {
          "name": "title",
          "label": "Policy",
          "type": "text",
          "required": true,
          "max": 160
        },
        {
          "name": "category",
          "label": "Category",
          "type": "select",
          "options": [
            {
              "value": "privacy",
              "label": "Privacy"
            },
            {
              "value": "security",
              "label": "Security"
            },
            {
              "value": "accessibility",
              "label": "Accessibility"
            },
            {
              "value": "terms",
              "label": "Terms"
            },
            {
              "value": "cookies",
              "label": "Cookies"
            },
            {
              "value": "acceptable-use",
              "label": "Acceptable use"
            },
            {
              "value": "other",
              "label": "Other"
            }
          ],
          "filter": true
        },
        {
          "name": "version",
          "label": "Version",
          "type": "text",
          "max": 40
        },
        {
          "name": "effective",
          "label": "Effective from",
          "type": "date"
        },
        {
          "name": "summary",
          "label": "Summary",
          "type": "text",
          "max": 300
        },
        {
          "name": "body",
          "label": "Policy text",
          "type": "textarea",
          "max": 20000
        }
      ],
      "listFields": [
        "category",
        "version",
        "effective"
      ],
      "empty": "Approved policies will be published here. Our current privacy notices are linked below."
    },
    {
      "key": "questions",
      "type": "items",
      "title": "Trust and privacy questions",
      "view": "manager",
      "create": "public",
      "manage": "admin",
      "reference": true,
      "comments": true,
      "consent": "I understand HN Group will use these details to respond, as described in the HN Group privacy notice.",
      "scope": "own",
      "singular": "question",
      "cta": "Ask a question",
      "fields": [
        {
          "name": "name",
          "label": "Your name",
          "type": "text",
          "required": true,
          "max": 120,
          "autocomplete": "name"
        },
        {
          "name": "email",
          "label": "Email",
          "type": "email",
          "required": true,
          "contact": true,
          "autocomplete": "email"
        },
        {
          "name": "topic",
          "label": "Topic",
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "privacy-and-personal-data",
              "label": "Privacy and personal data"
            },
            {
              "value": "data-request",
              "label": "Data request"
            },
            {
              "value": "security",
              "label": "Security"
            },
            {
              "value": "accessibility",
              "label": "Accessibility"
            },
            {
              "value": "other",
              "label": "Other"
            }
          ],
          "filter": true
        },
        {
          "name": "body",
          "label": "Your question",
          "type": "textarea",
          "max": 20000
        }
      ],
      "statuses": [
        {
          "id": "new",
          "label": "New"
        },
        {
          "id": "in-progress",
          "label": "In progress"
        },
        {
          "id": "resolved",
          "label": "Resolved"
        },
        {
          "id": "closed",
          "label": "Closed"
        }
      ],
      "empty": "Submissions are private to the person who sent them and our team. Use the button above to send one, or check an existing one with your private reference."
    }
  ],
  "seedAuthor": "HN Group"
}
