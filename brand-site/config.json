      "manage": "admin",
      "publish": true,
      "comments": false,
      "singular": "guideline",
      "intro": "Brand guidance documents published by the group.",
      "files": "manager",
      "fields": [
        {
          "name": "title",
          "label": "Title",
          "type": "text",
          "required": true,
          "max": 160
        },
        {
          "name": "summary",
          "label": "Summary",
          "type": "text",
          "max": 300
        },
        {
          "name": "category",
          "label": "Category",
          "type": "select",
          "options": [
            {
              "value": "logos",
              "label": "Logos"
            },
            {
              "value": "colour",
              "label": "Colour"
            },
            {
              "value": "typography",
              "label": "Typography"
            },
            {
              "value": "writing",
              "label": "Writing"
            },
            {
              "value": "templates",
              "label": "Templates"
            },
            {
              "value": "other",
              "label": "Other"
            }
          ],
          "filter": true
        },
        {
          "name": "body",
          "label": "Guidance",
          "type": "textarea",
          "max": 20000
        }
      ],
      "listFields": [
        "category"
      ],
      "empty": "No additional guideline documents have been published yet. The logo, colour and typography guidance is on the Logos & assets page."
    },
    {
      "key": "assets",
