      "manage": "admin",
      "publish": true,
      "comments": false,
      "singular": "asset",
      "intro": "Templates and other approved brand files.",
      "files": "manager",
      "fields": [
        {
          "name": "title",
          "label": "Title",
          "type": "text",
          "required": true,
          "max": 160
        },
        {
          "name": "summary",
          "label": "Summary",
          "type": "text",
          "max": 300
        },
        {
          "name": "company",
          "label": "Company",
